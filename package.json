{
  "name": "play-spark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "check:catalog": "tsx server/seedCatalog.ts --validate-only",
    "check:progress": "node scripts/check-progress-update.mjs",
    "seed:catalog": "tsx server/seedCatalog.ts",
    "setup:auth": "tsx server/setupAuth.ts",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run check && npm run check:catalog && npm test && npm run build && npm run check:progress",
    "start": "node server-dist/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongodb": "^6.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.14"
  }
}
