# Copy to .env for local development. Never commit the real value.
MONGODB_URI="mongodb+srv://<database-user>:<password>@<cluster-host>/play_spark_dev?retryWrites=true&w=majority"
MONGODB_DB_NAME="play_spark_dev"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=3000
# Public origin used in password-reset links. Use the Vite address for local development.
APP_BASE_URL="http://localhost:5173"
# Configure both values to enable password-reset email delivery.
# RESEND_API_KEY="re_your_resend_api_key"
# RESEND_FROM_EMAIL="Play Spark <no-reply@your-verified-domain.example>"
